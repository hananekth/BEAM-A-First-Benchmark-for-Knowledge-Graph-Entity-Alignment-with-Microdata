# BEAM-App runtime configuration

# Web app
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8501

# Worker
MAX_CONCURRENT_JOBS=2
JOB_POLL_INTERVAL=1
MAX_WORKERS_PER_JOB=8

# Optional class catalog override
# WDC_CLASSES_CATALOG_PATH=/absolute/path/to/wdc_classes_catalog.json

# Optional align/query tuning
ALIGN_MAX_WORKERS=8
WIKIDATA_QUERY_MAX_RETRIES=4
WIKIDATA_QUERY_RETRY_DELAY=2.0
WIKIDATA_QUERY_TIMEOUT=300
