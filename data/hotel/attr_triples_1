C2 \\u03C5\\u03C0\\u03B7\\u03C1\\u03B5\\u03C3\\u03AF\\u03B1 \\u03BC\\u03C0\\u03AC\\u03C4\\u03BB\\u03B5\\u03C1, \\u03C5\\u03C0\\u03B7\\u03C1\\u03B5\\u03C3\\u03AF\\u03B1 \\u03B8\\u03C5\\u03C1\\u03C9\\u03C1\\u03B5\\u03AF\\u03BF\\u03C5 \\u03BA\\u03B1\\u03B9 \\u03B5\\u03C0\\u03B9\\u03BB\\u03BF\\u03B3\\u03AE \\u03BC\\u03B1\\u03BE\\u03B9\\u03BB\\u03B1\\u03C1\\u03B9\\u03BF\\u03CD. \\u03A4\\u03BF \\u03C0\\u03BB\\u03AE\\u03C1\\u03C9\\u03C2 \\u03B5\\u03BE\\u03BF\\u03C0\\u03BB\\u03B9\\u03C3\\u03BC\\u03AD\\u03BD\\u03BF \\u03C3\\u03C0\\u03B1 \\u03BA\\u03B1\\u03B9 \\u03BA\\u03AD\\u03BD\\u03C4\\u03C1\\u03BF \\u03B5\\u03C5\\u03B5\\u03BE\\u03AF\\u03B1\\u03C2 \\u03C4\\u03BF\\u03C5 Kempinski \\u03C0\\u03B5\\u03C1\\u03B9\\u03BB\\u03B1\\u03BC\\u03B2\\u03AC\\u03BD\\u03B5\\u03B9 \\u03B4\\u03C9\\u03C1\\u03B5\\u03AC\\u03BD \\u03C5\\u03B4\\u03C1\\u03BF\\u03BC\\u03B1\\u03C3\\u03AC\\u03B6, \\u03B1\\u03C4\\u03BC\\u03CC\\u03BB\\u03BF\\u03C5\\u03C4\\u03C1\\u03B1 \\u03BA\\u03B1\\u03B9 \\u03C3\\u03AC\\u03BF\\u03C5\\u03BD\\u03B5\\u03C2. \\u039C\\u03C0\\u03BF\\u03C1\\u03B5\\u03AF\\u03C4\\u03B5 \\u03BD\\u03B1 \\u03C7\\u03B1\\u03BB\\u03B1\\u03C1\\u03CE\\u03C3\\u03B5\\u03C4\\u03B5 \\u03BC\\u03B5 \\u03BC\\u03B1\\u03C3\\u03AC\\u03B6 \\u03B1\\u03C0\\u03CC \\u03B5\\u03BE\\u03B5\\u03B9\\u03B4\\u03B9\\u03BA\\u03B5\\u03C5\\u03BC\\u03AD\\u03BD\\u03BF \\u03C0\\u03C1\\u03BF\\u03C3\\u03C9\\u03C0\\u03B9\\u03BA\\u03CC \\u03AE \\u03BD\\u03B1 \\u03B4\\u03C1\\u03BF\\u03C3\\u03B9\\u03C3\\u03C4\\u03B5\\u03AF\\u03C4\\u03B5 \\u03C3\\u03C4\\u03B7\\u03BD \\u03B5\\u03BE\\u03C9\\u03C4\\u03B5\\u03C1\\u03B9\\u03BA\\u03AE \\u03C0\\u03B9\\u03C3\\u03AF\\u03BD\\u03B1, \\u03C3\\u03C4\\u03BF\\u03BD \\u03C4\\u03B5\\u03BB\\u03B5\\u03C5\\u03C4\\u03B1\\u03AF\\u03BF \\u03CC\\u03C1\\u03BF\\u03C6\\u03BF \\u03C4\\u03BF\\u03C5 \\u03BE\\u03B5\\u03BD\\u03BF\\u03B4\\u03BF\\u03C7\\u03B5\\u03AF\\u03BF\\u03C5. \\u03A3\\u03C4\\u03BF Kempinski Nile Hotel \\u03BB\\u03B5\\u03B9\\u03C4\\u03BF\\u03C5\\u03C1\\u03B3\\u03BF\\u03CD\\u03BD \\u03B4\\u03B9\\u03AC