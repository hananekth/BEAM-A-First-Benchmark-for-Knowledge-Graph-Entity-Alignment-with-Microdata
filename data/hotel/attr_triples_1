_:nc6e38ccb9d504cbca907363b3b98ac98xb0	http://schema.org/description	"T\\u1ECDa l\\u1EA1c t\\u1EA1i B\\u00E3i bi\\u1EC3n Railay, th\\u00E0nh ph\\u1ED1 Krabi, Avatar Railay c\\u00F3 h\\u1ED3 b\\u01A1i ngo\\u00E0i tr\\u1EDDi v\\u00E0 s\\u00E2n hi\\u00EAn ph\\u01A1i n\\u1EAFng. Ch\\u1ED7 ngh\\u1EC9 n\\u00E0y n\\u1EB1m trong b\\u00E1n k\\u00EDnh ch\\u1EC9 900 m t\\u1EEB Hang Phra Nang. Du kh\\u00E1ch c\\u00F3 th\\u1EC3 th\\u01B0\\u1EDFng th\\u1EE9c b\\u1EEFa \\u0103n ngon t\\u1EA1i nh\\u00E0 h\\u00E0ng v\\u00E0 qu\\u00E1n bar ngay trong khu\\u00F4n vi\\u00EAn c\\u0169ng nh\\u01B0 Wi-Fi mi\\u1EC5n ph\\u00ED. M\\u1ED7i ph\\u00F2ng \\u0111\\u1EC1u c\\u00F3 TV truy\\u1EC1n h\\u00ECnh v\\u1EC7 tinh m\\u00E0n h\\u00ECnh ph\\u1EB3ng. M\\u1ED9t s\\u1ED1 ph\\u00F2ng \\u0111i k\\u00E8m khu v\\u1EF1c ti\\u1EBFp kh\\u00E1ch, n\\u01A1i du kh\\u00E1ch c\\u00F3 th\\u1EC3 th\\u01B0 gi\\u00E3n. Du kh\\u00E1ch c\\u00F3 th\\u1EC3 th\\u01B0\\u1EDFng th\\u1EE9c 1 t\\u00E1ch tr\\u00E0 trong khi ng\\u1EAFm nh\\u00ECn quang c\\u1EA3nh h\\u1ED3 b\\u01A1i ho\\u1EB7c khu v\\u01B0\\u1EDDn. T\\u1EA5t c\\u1EA3 c\\u00E1c ph\\u00F2ng c\\u00F2n c\\u00F3 ph\\u00F2ng t\\u1EAFm ri\\u00EAng v\\u1EDBi v\\u00F2i sen. \\u00C1o cho\\u00E0ng t\\u1EAFm v\\u00E0 d\\u00E9p c\\u0169ng \\u0111\\u01B0\\u1EE3c cung c\\u1EA5p \\u0111\\u1EC3 t\\u1EA1o s\\u1EF1 tho\\u1EA3i m\\u00E1i cho du kh\\u00E1ch. \\u0110\\u00EA\\u0309 ta\\u0323o th\\u00EAm thu\\u00E2\\u0323n ti\\u00EA\\u0323n cho t\\u1EA5t c\\u1EA3 du kha\\u0301ch, kh\\u00E1ch s\\u1EA1n c\\u00F2n cung c\\u1EA5p c\\u00E1c d\\u1ECBch v\\u1EE5 gi\\u1EB7t l\\u00E0 v\\u00E0 gi\\u1EEF h\\u00E0nh l\\u00FD. D\\u1ECBch v\\u1EE5 \\u0111\\u01B0a \\u0111\\u00F3n s\\u00E2n bay \\u0111\\u01B0\\u1EE3c b\\u1ED1 tr\\u00ED theo y\\u00EAu c\\u1EA7u k\\u00E8m ph\\u1EE5 ph\\u00ED. \\u0110\\u1EA7m ph\\u00E1 Princess Lagoon n\\u1EB1m c\\u00E1ch Avatar Railay 800 m trong khi \\u0110i\\u1EC3m Leo N\\u00FAi \\u0111\\u00E1 Railay c\\u00E1ch \\u0111\\u00F3 800 m. T\\u1EEB ch\\u1ED7 ngh\\u1EC9 n\\u00E0y du kh\\u00E1ch \\u0111i ch\\u01B0a \\u0111\\u1EBFn 18 km l\\u00E0 t\\u1EDBi S\\u00E2n bay Krabi."
