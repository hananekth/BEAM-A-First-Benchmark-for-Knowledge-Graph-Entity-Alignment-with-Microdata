_:nc47f6f31b46541129914c2ff4bf918c0xb0	http://schema.org/description	"Kh\\u00E1ch s\\u1EA1n \\u0111\\u1EB3ng c\\u1EA5p sao g\\u1EA7n B\\u1EBFn ph\\u00E0 \\u0110\\u1EA3o Magnetic H\\u1ED3 b\\u01A1i ngo\\u00E0i tr\\u1EDDi, nh\\u00E0 h\\u00E0ng v\\u00E0 trung t\\u00E2m th\\u1EC3 d\\u1EE5c ph\\u1EE5c v\\u1EE5 24 gi\\u1EDD l\\u00E0 nh\\u1EEFng ti\\u1EC7n nghi, d\\u1ECBch v\\u1EE5 n\\u1ED5i b\\u1EADt t\\u1EA1i kha\\u0301ch sa\\u0323n kh\\u00F4ng kh\\u00F3i thu\\u1ED1c n\\u00E0y. Kh\\u00E1ch c\\u00F3 th\\u1EC3 s\\u1EED d\\u1EE5ng Wifi t\\u1EA1i khu v\\u1EF1c chung mi\\u1EC5n ph\\u00ED. B\\u00EAn c\\u1EA1nh \\u0111\\u00F3 c\\u00F2n c\\u00F3 qu\\u1EA7y bar\\/khu lounge, d\\u1ECBch v\\u1EE5 ph\\u00F2ng 24 gi\\u1EDD v\\u00E0 trung t\\u00E2m d\\u1ECBch v\\u1EE5 v\\u0103n ph\\u00F2ng. Hotel Grand Chancellor Townsville c\\u00F3 200 ph\\u00F2ng \\u0111\\u01B0\\u1EE3c trang b\\u1ECB \\u0111i\\u1EC1u h\\u00F2a v\\u1EDBi k\\u00E9t b\\u1EA3o m\\u1EADt v\\u00E0 m\\u00E1y s\\u1EA5y t\\u00F3c. C\\u00F3 danh s\\u00E1ch c\\u00E1c lo\\u1EA1i g\\u1ED1i cho kh\\u00E1ch ch\\u1ECDn l\\u1EF1a. TV LCD 55-inch c\\u00F3 c\\u00E1c k\\u00EAnh truy\\u1EC1n h\\u00ECnh k\\u1EF9 thu\\u1EADt s\\u1ED1. Ph\\u00F2ng t\\u1EAFm c\\u00F3 bu\\u1ED3ng t\\u1EAFm v\\u00F2i sen v\\u00E0 \\u0111\\u00F4\\u0300 d\\u00F9ng nha\\u0300 t\\u0103\\u0301m mi\\u00EA\\u0303n phi\\u0301. Kha\\u0301ch sa\\u0323n t\\u1EA1i Townsville n\\u00E0y cung c\\u1EA5p k\\u1EBFt n\\u1ED1i Internet kh\\u00F4ng d\\u00E2y mi\\u1EC5n ph\\u00ED. C\\u00E1c ti\\u1EC7n nghi ph\\u1EE5c v\\u1EE5 nhu c\\u1EA7u c\\u00F4ng vi\\u1EC7c g\\u1ED3m b\\u00E0n v\\u00E0 \\u0111i\\u1EC7n tho\\u1EA1i. Ngo\\u00E0i ra, c\\u00E1c ph\\u00F2ng c\\u00F2n c\\u00F3 b\\u00E0n \\u1EE7i\\/d\\u1EE5ng c\\u1EE5 \\u1EE7i qu\\u1EA7n \\u00E1o v\\u00E0 m\\u00E0n\\/r\\u00E8m c\\u1EA3n s\\u00E1ng. C\\u00F3 d\\u1ECBch v\\u1EE5 d\\u1ECDn ph\\u00F2ng h\\u00E0ng ng\\u00E0y. C\\u00E1c ti\\u1EC7n nghi th\\u1EC3 thao, gi\\u1EA3i tr\\u00ED t\\u1EA1i kha\\u0301ch sa\\u0323n g\\u1ED3m h\\u1ED3 b\\u01A1i ngo\\u00E0i tr\\u1EDDi v\\u00E0 trung t\\u00E2m th\\u1EC3 d\\u1EE5c ph\\u1EE5c v\\u1EE5 24 gi\\u1EDD. Ho\\u1EA1t \\u0111\\u1ED9ng th\\u1EC3 thao, gi\\u1EA3i tr\\u00ED trong danh s\\u00E1ch b\\u00EAn d\\u01B0\\u1EDBi ho\\u1EB7c c\\u00F3 trong khu\\u00F4n vi\\u00EAn ho\\u1EB7c trong khu v\\u1EF1c l\\u00E2n c\\u1EADn; kh\\u00E1ch c\\u00F3 th\\u1EC3 ph\\u1EA3i thanh to\\u00E1n th\\u00EAm ph\\u1EE5 ph\\u00ED."
