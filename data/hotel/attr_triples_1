_:nf4b40962e4f64f4e8645fb20d77ae9b6xb0	http://schema.org/description	"Kh\\u00E1ch s\\u1EA1n \\u0111\\u1EB3ng c\\u1EA5p, c\\u00E1ch \\u0110\\u1EA1i Th\\u00E1nh \\u0111\\u01B0\\u1EDDng H\\u1ED3i gi\\u00E1o Mecca v\\u00E0i ph\\u00FAt \\u0111i b\\u1ED9 Kha\\u0301ch sa\\u0323n n\\u00E0y c\\u00F3 4 nh\\u00E0 h\\u00E0ng, 2 ti\\u1EC7m c\\u00E0 ph\\u00EA\\/qu\\u00E1n c\\u00E0 ph\\u00EA v\\u00E0 ti\\u1EC7m\\/c\\u1EEDa h\\u00E0ng \\u0111\\u1ED3 \\u0103n nhanh. Kh\\u00E1ch c\\u00F3 th\\u1EC3 s\\u1EED d\\u1EE5ng Wifi t\\u1EA1i khu v\\u1EF1c chung mi\\u1EC5n ph\\u00ED. B\\u00EAn c\\u1EA1nh \\u0111\\u00F3 c\\u00F2n c\\u00F3 b\\u00E3i \\u0111\\u1EADu xe t\\u1EF1 ph\\u1EE5c v\\u1EE5, d\\u1ECBch v\\u1EE5 ph\\u00F2ng 24 gi\\u1EDD v\\u00E0 trung t\\u00E2m d\\u1ECBch v\\u1EE5 v\\u0103n ph\\u00F2ng. Conrad Makkah c\\u00F3 438 ph\\u00F2ng \\u0111\\u01B0\\u1EE3c trang b\\u1ECB \\u0111i\\u1EC1u h\\u00F2a v\\u1EDBi minibar v\\u00E0 k\\u00E9t b\\u1EA3o m\\u1EADt \\u0111\\u1EB7t \\u0111\\u01B0\\u1EE3c m\\u00E1y t\\u00EDnh x\\u00E1ch tay. Gi\\u01B0\\u1EDDng \\u0111\\u01B0\\u1EE3c trang b\\u1ECB b\\u1ED9 \\u0111\\u00F4\\u0300 gi\\u01B0\\u01A1\\u0300ng cao c\\u00E2\\u0301p. C\\u00E1c ph\\u00F2ng \\u0111\\u01B0\\u1EE3c trang b\\u1ECB TV LCD. Ph\\u00F2ng t\\u1EAFm c\\u00F3 b\\u1ED3n t\\u1EAFm v\\u00E0 bu\\u1ED3ng t\\u1EAFm v\\u00F2i sen ri\\u00EAng v\\u1EDBi v\\u00F2i sen phun m\\u01B0a v\\u00E0 v\\u00F2i sen th\\u1EE7y l\\u1EF1c, a\\u0301o choa\\u0300ng t\\u0103\\u0301m, ch\\u1EADu v\\u1EC7 sinh\\/v\\u00F2i r\\u1EEDa v\\u00E0 \\u0111\\u00F4\\u0300 d\\u00F9ng nha\\u0300 t\\u0103\\u0301m mi\\u00EA\\u0303n phi\\u0301. Kh\\u00E1ch c\\u00F3 th\\u1EC3 tho\\u1EA3i m\\u00E1i l\\u01B0\\u1EDBt web v\\u1EDBi k\\u1EBFt n\\u1ED1i Internet c\\u00F3 d\\u00E2y v\\u00E0 kh\\u00F4ng d\\u00E2y mi\\u1EC5n ph\\u00ED. C\\u00E1c ti\\u1EC7n nghi ph\\u1EE5c v\\u1EE5 nhu c\\u1EA7u c\\u00F4ng vi\\u1EC7c g\\u1ED3m b\\u00E0n, gh\\u1EBF cho b\\u00E0n l\\u00E0m vi\\u1EC7c v\\u00E0 b\\u00E1o mi\\u1EC5n ph\\u00ED. C\\u00F3 d\\u1ECBch v\\u1EE5 d\\u1ECDn ph\\u00F2ng h\\u00E0ng ng\\u00E0y."
