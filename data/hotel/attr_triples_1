_:n8d762509704a4e97a05493333bd17a4exb0	http://schema.org/description	"Kh\\u00E1ch s\\u1EA1n ph\\u00F9 h\\u1EE3p cho kh\\u00E1ch gia \\u0111\\u00ECnh t\\u1EA1i khu v\\u1EF1c Kirkos, Addis Ababa, v\\u1EDBi 3 nh\\u00E0 h\\u00E0ng C\\u00F9ng v\\u1EDBi 3 nh\\u00E0 h\\u00E0ng, kha\\u0301ch sa\\u0323n n\\u00E0y c\\u00F3 khu spa v\\u1EDBi \\u0111\\u1EA7y \\u0111\\u1EE7 c\\u00E1c li\\u1EC7u ph\\u00E1p v\\u00E0 h\\u1ED3 b\\u01A1i ngo\\u00E0i tr\\u1EDDi. B\\u00E3i \\u0111\\u1EADu xe t\\u1EF1 ph\\u1EE5c v\\u1EE5 mi\\u1EC5n ph\\u00ED. Ngo\\u00E0i ra, trong khu\\u00F4n vi\\u00EAn c\\u00F2n c\\u00F3 2 qu\\u00E1n bar c\\u1EA1nh h\\u1ED3 b\\u01A1i, 3 qu\\u1EA7y bar\\/khu lounge v\\u00E0 c\\u00E2u l\\u1EA1c b\\u1ED9 s\\u1EE9c kh\\u1ECFe. Hilton Addis Ababa c\\u00F3 372 ph\\u00F2ng v\\u1EDBi minibar v\\u00E0 k\\u00E9t b\\u1EA3o m\\u1EADt \\u0111\\u1EB7t \\u0111\\u01B0\\u1EE3c m\\u00E1y t\\u00EDnh x\\u00E1ch tay. C\\u00E1c ph\\u00F2ng m\\u1EDF ra ban c\\u00F4ng. C\\u00E1c ph\\u00F2ng c\\u00F3 khu ti\\u1EBFp kh\\u00E1ch t\\u00E1ch bi\\u1EC7t. TV LCD c\\u00F3 c\\u00E1c k\\u00EAnh truy\\u1EC1n h\\u00ECnh v\\u1EC7 tinh cao c\\u1EA5p. Ph\\u00F2ng t\\u1EAFm c\\u00F3 v\\u00F2i sen\\/b\\u1ED3n t\\u1EAFm k\\u1EBFt h\\u1EE3p, \\u0111\\u1ED3 d\\u00F9ng nh\\u00E0 t\\u1EAFm \\u0111\\u01B0\\u1EE3c thi\\u1EBFt k\\u1EBF ri\\u00EAng, \\u0111\\u00F4\\u0300 d\\u00F9ng nha\\u0300 t\\u0103\\u0301m mi\\u00EA\\u0303n phi\\u0301 v\\u00E0 m\\u00E1y s\\u1EA5y t\\u00F3c. T\\u1EA1i kha\\u0301ch sa\\u0323n \\u1EDF Addis Ababa n\\u00E0y, kh\\u00E1ch c\\u00F3 th\\u1EC3 truy c\\u1EADp Internet c\\u00F3 d\\u00E2y v\\u00E0 kh\\u00F4ng d\\u00E2y v\\u1EDBi kho\\u1EA3n ph\\u1EE5 ph\\u00ED nh\\u1ECF. C\\u00E1c ti\\u1EC7n nghi ph\\u1EE5c v\\u1EE5 nhu c\\u1EA7u c\\u00F4ng vi\\u1EC7c g\\u1ED3m b\\u00E0n, b\\u00E1o mi\\u1EC5n ph\\u00ED v\\u00E0 \\u0111i\\u1EC7n tho\\u1EA1i. Ngo\\u00E0i ra, c\\u00E1c ph\\u00F2ng c\\u00F2n c\\u00F3 n\\u01B0\\u1EDBc \\u0111\\u00F3ng chai mi\\u1EC5n ph\\u00ED v\\u00E0 d\\u1EE5ng c\\u1EE5 pha c\\u00E0 ph\\u00EA\\/tr\\u00E0. C\\u00F3 d\\u1ECBch v\\u1EE5 d\\u1ECDn ph\\u00F2ng h\\u00E0ng ng\\u00E0y. Kha\\u0301ch sa\\u0323n c\\u00F3 4 s\\u00E2n qu\\u1EA7n v\\u1EE3t ngo\\u00E0i tr\\u1EDDi v\\u00E0 c\\u00E2u l\\u1EA1c b\\u1ED9 s\\u1EE9c kh\\u1ECFe. Trong khu\\u00F4n vi\\u00EAn c\\u00F3 h\\u1ED3 b\\u01A1i ngo\\u00E0i tr\\u1EDDi, h\\u1ED3 b\\u01A1i d\\u00E0nh cho tr\\u1EBB em v\\u00E0 b\\u1ED3n t\\u1EAFm th\\u1EE7y l\\u1EF1c. C\\u00E1c ti\\u1EC7n nghi th\\u1EC3 thao, gi\\u1EA3i tr\\u00ED kh\\u00E1c bao g\\u1ED3m ph\\u00F2ng t\\u1EAFm h\\u01A1i v\\u00E0 trung t\\u00E2m th\\u1EC3 d\\u1EE5c. Ho\\u1EA1t \\u0111\\u1ED9ng th\\u1EC3 thao, gi\\u1EA3i tr\\u00ED trong danh s\\u00E1ch b\\u00EAn d\\u01B0\\u1EDBi ho\\u1EB7c c\\u00F3 trong khu\\u00F4n vi\\u00EAn ho\\u1EB7c trong khu v\\u1EF1c l\\u00E2n c\\u1EADn; kh\\u00E1ch c\\u00F3 th\\u1EC3 ph\\u1EA3i thanh to\\u00E1n th\\u00EAm ph\\u1EE5 ph\\u00ED."
