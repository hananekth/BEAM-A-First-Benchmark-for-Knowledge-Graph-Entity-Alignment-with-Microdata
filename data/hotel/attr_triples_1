_:n216b037f3857492f87a670e8bf280926xb0	http://schema.org/description	"\\u0423 \\u043F\\u043E\\u043C\\u0435\\u0448\\u043A\\u0430\\u043D\\u043D\\u0456 21c Museum Hotel Kansas City, \\u044F\\u043A\\u0435 \\u0440\\u043E\\u0437\\u0442\\u0430\\u0448\\u043E\\u0432\\u0430\\u043D\\u043E \\u0432 \\u043C\\u0456\\u0441\\u0442\\u0456 \\u041A\\u0430\\u043D\\u0437\\u0430\\u0441-\\u0421\\u0456\\u0442\\u0456, \\u0437\\u0430 7 \\u0445\\u0432. \\u0445\\u043E\\u0434\\u044C\\u0431\\u0438 \\u0432\\u0456\\u0434 \\u043F\\u0430\\u043C'\\u044F\\u0442\\u043A\\u0438 \\\"\\u041A\\u043E\\u043D\\u0433\\u0440\\u0435\\u0441-\\u0446\\u0435\\u043D\\u0442\\u0440 \\u041A\\u0430\\u043D\\u0437\\u0430\\u0441-\\u0421\\u0456\\u0442\\u0456\\\", \\u043F\\u0440\\u043E\\u043F\\u043E\\u043D\\u0443\\u044E\\u0442\\u044C \\u043D\\u043E\\u043C\\u0435\\u0440\\u0438 \\u0434\\u043B\\u044F \\u0430\\u043B\\u0435\\u0440\\u0433\\u0456\\u043A\\u0456\\u0432. \\u0422\\u0443\\u0442 \\u0434\\u043E \\u043F\\u043E\\u0441\\u043B\\u0443\\u0433 \\u0433\\u043E\\u0441\\u0442\\u0435\\u0439 \\u043F\\u043E\\u0441\\u043B\\u0443\\u0433\\u0438 \\u043A\\u043E\\u043D\\u0441\\u044C\\u0454\\u0440\\u0436\\u0430, \\u0444\\u0456\\u0442\\u043D\\u0435\\u0441-\\u0446\\u0435\\u043D\\u0442\\u0440, \\u0431\\u0435\\u0437\\u043A\\u043E\\u0448\\u0442\\u043E\\u0432\\u043D\\u0438\\u0439 Wi-Fi \\u043D\\u0430 \\u0432\\u0441\\u0456\\u0439 \\u0442\\u0435\\u0440\\u0438\\u0442\\u043E\\u0440\\u0456\\u0457 \\u043F\\u043E\\u043C\\u0435\\u0448\\u043A\\u0430\\u043D\\u043D\\u044F \\u0442\\u0430 \\u0431\\u0430\\u0440. \\u0414\\u043E \\u043F\\u043E\\u0441\\u043B\\u0443\\u0433 \\u0433\\u043E\\u0441\\u0442\\u0435\\u0439 \\u043F\\u043E\\u043C\\u0435\\u0448\\u043A\\u0430\\u043D\\u043D\\u044F \\u0446\\u0456\\u043B\\u043E\\u0434\\u043E\\u0431\\u043E\\u0432\\u0430 \\u0441\\u0442\\u0456\\u0439\\u043A\\u0430 \\u0440\\u0435\\u0454\\u0441\\u0442\\u0440\\u0430\\u0446\\u0456\\u0457 \\u0456 \\u0440\\u0435\\u0441\\u0442\\u043E\\u0440\\u0430\\u043D. \\u041F\\u043E\\u043C\\u0435\\u0448\\u043A\\u0430\\u043D\\u043D\\u044F \\u0440\\u043E\\u0437\\u043C\\u0456\\u0449\\u0435\\u043D\\u043E \\u0437\\u0430 2,9 \\u043A\\u043C \\u0432\\u0456\\u0434 \\u043F\\u0430\\u043C'\\u044F\\u0442\\u043A\\u0438 \\\"Union Station Kansas City\\\" \\u0442\\u0430 \\u0437\\u0430 4,4 \\u043A\\u043C \\u0432\\u0456\\u0434 \\u043F\\u0430\\u043C'\\u044F\\u0442\\u043A\\u0438 \\\"\\u041D\\u0430\\u0446\\u0456\\u043E\\u043D\\u0430\\u043B\\u044C\\u043D\\u0438\\u0439 \\u043C\\u0443\\u0437\\u0435\\u0439 \\u041F\\u0435\\u0440\\u0448\\u043E\\u0457 \\u0421\\u0432\\u0456\\u0442\\u043E\\u0432\\u043E\\u0457 \\u0432\\u0456\\u0439\\u043D\\u0438 \\u0432 \\u041C\\u0435\\u043C\\u043E\\u0440\\u0456\\u0430\\u043B\\u0456 \\u0421\\u0432\\u043E\\u0431\\u043E\\u0434\\u0438\\\". \\u0423 \\u043F\\u043E\\u043C\\u0435\\u0448\\u043A\\u0430\\u043D\\u043D\\u0456 21c Museum Hotel Kansas City \\u0434\\u043E\\u0441\\u0442\\u0443\\u043F\\u043D\\u0456 \\u043D\\u043E\\u043C\\u0435\\u0440\\u0438 \\u0437 \\u043A\\u043E\\u043D\\u0434\\u0438\\u0446\\u0456\\u043E\\u043D\\u0435\\u0440\\u043E\\u043C, \\u044F\\u043A\\u0456 \\u043E\\u0441\\u043D\\u0430\\u0449\\u0435\\u043D\\u0456 \\u0448\\u0430\\u0444\\u043E\\u044E, \\u043A\\u0430\\u0432\\u043E\\u0432\\u0430\\u0440\\u043A\\u043E\\u044E, \\u0441\\u0435\\u0439\\u0444\\u043E\\u043C, \\u0442\\u0435\\u043B\\u0435\\u0432\\u0456\\u0437\\u043E\\u0440\\u043E\\u043C \\u0456\\u0437 \\u043F\\u043B\\u043E\\u0441\\u043A\\u0438\\u043C \\u0435\\u043A\\u0440\\u0430\\u043D\\u043E\\u043C \\u0442\\u0430 \\u043E\\u043A\\u0440\\u0435\\u043C\\u043E\\u044E \\u0432\\u0430\\u043D\\u043D\\u043E\\u044E \\u043A\\u0456\\u043C\\u043D\\u0430\\u0442\\u043E\\u044E \\u0437 \\u0434\\u0443\\u0448\\u0435\\u043C. \\u0423 \\u043F\\u043E\\u043C\\u0435\\u0448\\u043A\\u0430\\u043D\\u043D\\u0456 21c Museum Hotel Kansas City \\u043A\\u043E\\u0436\\u0435\\u043D \\u043D\\u043E\\u043C\\u0435\\u0440 \\u043E\\u0441\\u043D\\u0430\\u0449\\u0435\\u043D\\u0438\\u0439 \\u043F\\u043E\\u0441\\u0442\\u0456\\u043B\\u044C\\u043D\\u043E\\u044E \\u0431\\u0456\\u043B\\u0438\\u0437\\u043D\\u043E\\u044E \\u0442\\u0430 \\u0440\\u0443\\u0448\\u043D\\u0438\\u043A\\u0430\\u043C\\u0438. \\u0429\\u043E\\u0440\\u0430\\u043D\\u043A\\u0443 \\u0432 \\u043F\\u043E\\u043C\\u0435\\u0448\\u043A\\u0430\\u043D\\u043D\\u0456 21c Museum Hotel Kansas City \\u0434\\u043E\\u0441\\u0442\\u0443\\u043F\\u043D\\u0456 \\u0442\\u0430\\u043A\\u0456 \\u0432\\u0430\\u0440\\u0456\\u0430\\u043D\\u0442\\u0438 \\u0441\\u043D\\u0456\\u0434\\u0430\\u043D\\u043A\\u0443: \\\"\\u0448\\u0432\\u0435\\u0434\\u0441\\u044C\\u043A\\u0438\\u0439 \\u0441\\u0442\\u0456\\u043B\\\" \\u0447\\u0438 \\u0430\\u043C\\u0435\\u0440\\u0438\\u043A\\u0430\\u043D\\u0441\\u044C\\u043A\\u0438\\u0439. \\u0423 \\u043F\\u043E\\u043C\\u0435\\u0448\\u043A\\u0430\\u043D\\u043D\\u0456 21c Museum Hotel Kansas City \\u043F\\u0440\\u0430\\u0446\\u044E\\u0454 \\u0431\\u0456\\u0437\\u043D\\u0435\\u0441-\\u0446\\u0435\\u043D\\u0442\\u0440. \\u0413\\u043E\\u0441\\u0442\\u0456 \\u043C\\u043E\\u0436\\u0443\\u0442\\u044C \\u0442\\u0430\\u043A\\u043E\\u0436 \\u043A\\u043E\\u0440\\u0438\\u0441\\u0442\\u0443\\u0432\\u0430\\u0442\\u0438\\u0441\\u044F \\u0431\\u0430\\u043D\\u043A\\u043E\\u043C\\u0430\\u0442\\u043E\\u043C \\u043D\\u0430 \\u0442\\u0435\\u0440\\u0438\\u0442\\u043E\\u0440\\u0456\\u0457 \\u043F\\u043E\\u043C\\u0435\\u0448\\u043A\\u0430\\u043D\\u043D\\u044F 21c Museum Hotel Kansas City. \\u041F\\u043E\\u0440\\u0443\\u0447 \\u0456\\u0437 \\u043F\\u043E\\u043C\\u0435\\u0448\\u043A\\u0430\\u043D\\u043D\\u044F\\u043C 21c Museum Hotel Kansas City \\u0440\\u043E\\u0437\\u043C\\u0456\\u0449\\u0435\\u043D\\u0456 \\u0442\\u0430\\u043A\\u0456 \\u043F\\u043E\\u043F\\u0443\\u043B\\u044F\\u0440\\u043D\\u0456 \\u0432\\u0438\\u0437\\u043D\\u0430\\u0447\\u043D\\u0456 \\u043F\\u0430\\u043C'\\u044F\\u0442\\u043A\\u0438, \\u044F\\u043A C\\u043F\\u0440\\u0438\\u043D\\u0442 \\u0426\\u0435\\u043D\\u0442\\u0440, Historic Power and Light Building \\u0442\\u0430 Bartle Hall Convention Center. \\u041