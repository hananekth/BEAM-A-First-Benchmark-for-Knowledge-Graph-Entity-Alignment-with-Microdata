_:nd2ada44374e046729b28857dcf0e2aa9xb0	http://schema.org/description	"\\u041F\\u043B\\u044F\\u0436\\u043D\\u0438\\u0439 \\u043A\\u0443\\u0440\\u043E\\u0440\\u0442\\u043D\\u0438\\u0439 \\u0433\\u043E\\u0442\\u0435\\u043B\\u044C Sentido Mamlouk Palace \\u0440\\u043E\\u0437\\u0442\\u0430\\u0448\\u043E\\u0432\\u0430\\u043D\\u0438\\u0439 \\u0432 \\u0425\\u0443\\u0440\\u0433\\u0430\\u0434\\u0456. \\u0414\\u043E \\u043F\\u043E\\u0441\\u043B\\u0443\\u0433 \\u0433\\u043E\\u0441\\u0442\\u0435\\u0439 \\u0432\\u043B\\u0430\\u0441\\u043D\\u0438\\u0439 \\u043F\\u043B\\u044F\\u0436, \\u0432\\u043E\\u0434\\u043D\\u0456 \\u0433\\u0456\\u0440\\u043A\\u0438 \\u0442\\u0430 2 \\u0432\\u0435\\u043B\\u0438\\u043A\\u0438\\u0445 \\u0432\\u0456\\u0434\\u043A\\u0440\\u0438\\u0442\\u0438\\u0445 \\u0431\\u0430\\u0441\\u0435\\u0439\\u043D\\u0438, \\u043E\\u0442\\u043E\\u0447\\u0435\\u043D\\u0438\\u0445 \\u0432\\u0435\\u043B\\u0438\\u043A\\u0438\\u043C \\u0441\\u0430\\u0434\\u043E\\u043C. \\u0413\\u043E\\u0441\\u0442\\u044F\\u043C \\u043F\\u0440\\u043E\\u043F\\u043E\\u043D\\u0443\\u044E\\u0442\\u044C \\u043F\\u0440\\u043E\\u0441\\u0442\\u043E\\u0440\\u0456 \\u043D\\u043E\\u043C\\u0435\\u0440\\u0438 \\u0437 \\u0432\\u043B\\u0430\\u0441\\u043D\\u0438\\u043C \\u0431\\u0430\\u043B\\u043A\\u043E\\u043D\\u043E\\u043C. \\u041D\\u043E\\u043C\\u0435\\u0440\\u0438 \\u043A\\u0443\\u0440\\u043E\\u0440\\u0442\\u043D\\u043E\\u0433\\u043E \\u0433\\u043E\\u0442\\u0435\\u043B\\u044E Sentido Mamlouk Palace \\u0432\\u0438\\u0440\\u0456\\u0437\\u043D\\u044F\\u044E\\u0442\\u044C\\u0441\\u044F \\u043E\\u0444\\u043E\\u0440\\u043C\\u043B\\u0435\\u043D\\u043D\\u044F\\u043C \\u0443 \\u044F\\u0441\\u043A\\u0440\\u0430\\u0432\\u0438\\u0445 \\u043A\\u043E\\u043B\\u044C\\u043E\\u0440\\u0430\\u0445. \\u0412\\u0435\\u043B\\u0438\\u043A\\u0456 \\u0432\\u0456\\u043A\\u043D\\u0430 \\u0432\\u0438\\u0445\\u043E\\u0434\\u044F\\u0442\\u044C \\u043D\\u0430 \\u043C\\u0435\\u0431\\u043B\\u044C\\u043E\\u0432\\u0430\\u043D\\u0438\\u0439 \\