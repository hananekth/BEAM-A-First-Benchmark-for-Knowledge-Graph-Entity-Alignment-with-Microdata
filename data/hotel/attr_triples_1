_:n1f669be718b943659f3f67f84ca3ec3exb0	http://schema.org/description	"Kh\\u00E1ch s\\u1EA1n v\\u1EDBi 2 nh\\u00E0 h\\u00E0ng, c\\u00E1ch Trung t\\u00E2m Th\\u01B0\\u01A1ng m\\u1EA1i Grand Indonesia v\\u00E0i ph\\u00FAt \\u0111i b\\u1ED9 Kha\\u0301ch sa\\u0323n n\\u00E0y c\\u00F3 2 nh\\u00E0 h\\u00E0ng, khu spa v\\u1EDBi \\u0111\\u1EA7y \\u0111\\u1EE7 c\\u00E1c li\\u1EC7u ph\\u00E1p v\\u00E0 h\\u1ED3 b\\u01A1i ngo\\u00E0i tr\\u1EDDi. Kh\\u00E1ch c\\u00F3 th\\u1EC3 s\\u1EED d\\u1EE5ng Wifi mi\\u1EC5n ph\\u00ED t\\u1EA1i khu v\\u1EF1c chung l\\u1EABn b\\u00E3i \\u0111\\u1EADu xe t\\u1EF1 ph\\u1EE5c v\\u1EE5 mi\\u1EC5n ph\\u00ED. B\\u00EAn c\\u1EA1nh \\u0111\\u00F3 c\\u00F2n c\\u00F3 h\\u1ED9p \\u0111\\u00EAm, c\\u00E2u l\\u1EA1c b\\u1ED9 s\\u1EE9c kh\\u1ECFe v\\u00E0 qu\\u1EA7y bar\\/khu lounge. Thay kh\\u0103n t\\u1EAFm (theo y\\u00EAu c\\u1EA7u) Mandarin Oriental, Jakarta c\\u00F3 272 ph\\u00F2ng \\u0111\\u01B0\\u1EE3c trang b\\u1ECB \\u0111i\\u1EC1u h\\u00F2a v\\u1EDBi minibar v\\u00E0 k\\u00E9t b\\u1EA3o m\\u1EADt \\u0111\\u1EB7t \\u0111\\u01B0\\u1EE3c m\\u00E1y t\\u00EDnh x\\u00E1ch tay. C\\u00F3 danh s\\u00E1ch c\\u00E1c lo\\u1EA1i g\\u1ED1i cho kh\\u00E1ch ch\\u1ECDn l\\u1EF1a. TV LCD 42-inch \\u0111i c\\u00F9ng c\\u00E1c k\\u00EAnh truy\\u1EC1n h\\u00ECnh c\\u00E1p cao c\\u1EA5p. Ph\\u00F2ng t\\u1EAFm c\\u00F3 b\\u1ED3n t\\u1EAFm v\\u00E0 bu\\u1ED3ng t\\u1EAFm v\\u00F2i sen ri\\u00EAng v\\u1EDBi b\\u1ED3n t\\u1EAFm v\\u00E0 v\\u00F2i sen phun m\\u01B0a. C\\u00E1c ph\\u00F2ng t\\u1EAFm c\\u0169ng \\u0111\\u01B0\\u1EE3c trang b\\u1ECB a\\u0301o choa\\u0300ng t\\u0103\\u0301m, de\\u0301p \\u0111i trong nha\\u0300 v\\u00E0 \\u0111\\u00F4\\u0300 d\\u00F9ng nha\\u0300 t\\u0103\\u0301m mi\\u00EA\\u0303n phi\\u0301. Kh\\u00E1ch c\\u00F3 th\\u1EC3 tho\\u1EA3i m\\u00E1i l\\u01B0\\u1EDBt web v\\u1EDBi k\\u1EBFt n\\u1ED1i Internet kh\\u00F4ng d\\u00E2y mi\\u1EC5n ph\\u00ED (t\\u1ED1c \\u0111\\u1ED9 25+ Mbps). C\\u00E1c ti\\u1EC7n nghi ph\\u1EE5c v\\u1EE5 nhu c\\u1EA7u c\\u00F4ng vi\\u1EC7c g\\u1ED3m b\\u00E0n, gh\\u1EBF cho b\\u00E0n l\\u00E0m vi\\u1EC7c v\\u00E0 \\u0111i\\u1EC7n tho\\u1EA1i. Ngo\\u00E0i ra, c\\u00E1c ph\\u00F2ng c\\u00F2n c\\u00F3 b\\u00E1o mi\\u1EC5n ph\\u00ED v\\u00E0 n\\u01B0\\u1EDBc \\u0111\\u00F3ng chai mi\\u1EC5n ph\\u00ED. Kh\\u00E1ch c\\u00F3 th\\u1EC3 y\\u00EAu c\\u1EA7u massage t\\u1EA1i ph\\u00F2ng, thay kh\\u0103n t\\u1EAFm v\\u00E0 thay b\\u1ED9 tr\\u1EA3i gi\\u01B0\\u1EDDng. C\\u00F3 d\\u1ECBch v\\u1EE5 d\\u1ECDn ph\\u00F2ng bu\\u1ED5i t\\u1ED1i h\\u00E0ng \\u0111\\u00EAm v\\u00E0 d\\u1ECBch v\\u1EE5 d\\u1ECDn ph\\u00F2ng h\\u00E0ng ng\\u00E0y. C\\u00E1c ti\\u1EC7n nghi th\\u1EC3 thao, gi\\u1EA3i tr\\u00ED t\\u1EA1i kha\\u0301ch sa\\u0323n g\\u1ED3m h\\u1ED3 b\\u01A1i ngo\\u00E0i tr\\u1EDDi, c\\u00E2u l\\u1EA1c b\\u1ED9 s\\u1EE9c kh\\u1ECFe v\\u00E0 ph\\u00F2ng t\\u1EAFm h\\u01A1i. Ho\\u1EA1t \\u0111\\u1ED9ng th\\u1EC3 thao, gi\\u1EA3i tr\\u00ED trong danh s\\u00E1ch b\\u00EAn d\\u01B0\\u1EDBi ho\\u1EB7c c\\u00F3 trong khu\\u00F4n vi\\u00EAn ho\\u1EB7c trong khu v\\u1EF1c l\\u00E2n c\\u1EADn; kh\\u00E1ch c\\u00F3 th\\u1EC3 ph\\u1EA3i thanh to\\u00E1n th\\u00EAm ph\\u1EE5 ph\\u00ED."
